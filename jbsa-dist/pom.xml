<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.evildarkarchon</groupId>
    <artifactId>jbsa-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>jbsa-dist</artifactId>
  <packaging>pom</packaging>
  <name>JBSA build-only distribution assembly</name>

  <dependencies>
    <dependency>
      <groupId>io.github.evildarkarchon</groupId>
      <artifactId>jbsa</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.evildarkarchon</groupId>
      <artifactId>jbsa-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <properties>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- The root verify phase runs before this last reactor module can assemble inputs. -->
            <id>verify-assembled-release-inputs</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>pwsh</executable>
              <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
              <arguments>
                <argument>-NoLogo</argument>
                <argument>-NoProfile</argument>
                <argument>-NonInteractive</argument>
                <argument>-File</argument>
                <argument>${maven.multiModuleProjectDirectory}/build/verify-compliance.ps1</argument>
                <argument>-RequireGeneratedArtifacts</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
