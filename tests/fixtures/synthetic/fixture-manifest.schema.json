{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/jbsa/tests/fixtures/synthetic/fixture-manifest.schema.json",
  "title": "JBSA synthetic fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "generated_on",
    "reference_snapshot_revision",
    "generator",
    "fixtures",
    "goldens"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "reference_snapshot_revision": {
      "$ref": "#/$defs/referenceRevision"
    },
    "generator": {
      "$ref": "#/$defs/generatorIdentity"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "goldens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/golden"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "referenceRevision": {
      "const": "fd1e36020b2b5b6217e553dc0038983146a2e2dd"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "implementation",
        "implementation_spdx_license",
        "command",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "implementation_spdx_license": {
          "const": "Apache-2.0"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "command",
        "options"
      ],
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(artifacts/|goldens/sha256/)[a-z0-9][a-z0-9./-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "coverage",
        "creator",
        "source",
        "spdx_license",
        "generation",
        "reference_snapshot_revision",
        "oracle_sha256",
        "input_sha256",
        "output",
        "redistribution_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "structural-template",
            "generated-archive",
            "malformed-archive",
            "scenario",
            "golden-observation"
          ]
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "spdx_license": {
          "const": "CC0-1.0"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "reference_snapshot_revision": {
          "$ref": "#/$defs/referenceRevision"
        },
        "oracle_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "const": "4c34fe4173a2bd04ba52d5a6357348256ee424573785085fdafaab524cf7b0c2"
            }
          ]
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "redistribution_class": {
          "const": "project-authored-redistributable"
        }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "path",
        "source_fixture_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "type": "string",
          "pattern": "^goldens/sha256/[0-9a-f]{64}\\.json$"
        },
        "source_fixture_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
