{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/jbsa/tests/fixtures/synthetic/generator.schema.json",
  "title": "JBSA synthetic fixture generator catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_id", "generator_version", "algorithm", "recipes"],
  "properties": {
    "schema_version": {"const": 1},
    "generator_id": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "algorithm": {"type": "string", "minLength": 1},
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "coverage", "input", "output_path", "parameters"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"type": "string", "minLength": 1},
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "input": {"type": "string", "minLength": 1},
          "output_path": {
            "type": "string",
            "pattern": "^(artifacts/|goldens/sha256/)[a-z0-9][a-z0-9./-]*$"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    }
  }
}
